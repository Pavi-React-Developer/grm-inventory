RewriteEngine On

# DirectoryIndex configuration
DirectoryIndex index.php public/index.php

# Block direct access to internal directories
RewriteRule ^(views|app|config|database|scratch|storage)/ - [F,L]

# Directly serve uploads and assets from public folder
RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

# If the request is not for an existing file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Route everything to public/index.php
RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
